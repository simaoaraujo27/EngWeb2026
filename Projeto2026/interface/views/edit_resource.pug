extends layout

block content
  div(class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12")
    div(class="mb-8 flex items-center gap-4")
      a(href="/profile" class="p-2 bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-gray-400 dark:text-slate-500 hover:text-primary dark:hover:text-primary transition-all shadow-sm")
        i(data-lucide="arrow-left" class="w-5 h-5")
      div
        h1(class="text-3xl font-extrabold text-edu-dark dark:text-white") Editar Recurso
        p(class="text-edu-muted dark:text-slate-400") Atualize os metadados do recurso "#{resource.titulo}".

    div(class="bg-white dark:bg-slate-900 rounded-3xl border border-gray-100 dark:border-slate-800 shadow-xl overflow-hidden")
      div(class="p-8")
        form(class="space-y-8" action=`/resources/edit/${resource._id}` method="POST")
          div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
            div(class="space-y-2 md:col-span-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Título do Recurso
              input(class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all dark:text-white" type="text" name="titulo" value=resource.titulo required)
            
            div(class="space-y-2 md:col-span-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Subtítulo
              input(class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all dark:text-white" type="text" name="subtitulo" value=resource.subtitulo)

            div(class="space-y-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Tipo
              select(class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all dark:text-white" name="tipo" required)
                option(value="tese" selected=resource.tipo=='tese') 🎓 Tese
                option(value="artigo" selected=resource.tipo=='artigo') 📝 Artigo
                option(value="slides" selected=resource.tipo=='slides') 📊 Slides
                option(value="relatorio" selected=resource.tipo=='relatorio') 📄 Relatório
                option(value="aplicacao" selected=resource.tipo=='aplicacao') 💻 Aplicação
                option(value="teste_exame" selected=resource.tipo=='teste_exame') 📝 Teste / Exame
                option(value="problema_resolvido" selected=resource.tipo=='problema_resolvido') 🧩 Problema Resolvido

            div(class="space-y-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Ano de Publicação
              input(class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all dark:text-white" type="text" name="ano" value=resource.ano required)

            div(class="space-y-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Visibilidade
              select(class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all dark:text-white" name="visibilidade")
                option(value="publico" selected=resource.visibilidade=='publico') 🔓 Público
                option(value="privado" selected=resource.visibilidade=='privado') 🔒 Privado

            div(class="space-y-2 md:col-span-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Hashtags (separadas por vírgula)
              input(class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all dark:text-white" type="text" name="hashtags" value=(resource.hashtags ? resource.hashtags.join(', ') : ''))

          div(class="pt-4")
            button(class="w-full py-4 bg-primary text-white rounded-2xl font-bold hover:bg-primary-dark transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2" type="submit")
              i(data-lucide="check" class="w-5 h-5")
              | Atualizar Metadados
