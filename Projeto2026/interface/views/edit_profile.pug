extends layout

block content
  div(class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12")
    div(class="mb-8 flex items-center gap-4")
      a(href="/profile" class="p-2 bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-gray-400 dark:text-slate-500 hover:text-primary dark:hover:text-primary transition-all shadow-sm")
        i(data-lucide="arrow-left" class="w-5 h-5")
      div
        h1(class="text-3xl font-extrabold text-edu-dark dark:text-white") Editar Perfil
        p(class="text-edu-muted dark:text-slate-400") Atualize os seus dados de filiação e conta.

    div(class="bg-white dark:bg-slate-900 rounded-3xl border border-gray-100 dark:border-slate-800 shadow-xl overflow-hidden")
      div(class="p-8")
        form(class="space-y-8" action="/profile/edit" method="POST")
          div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
            div(class="space-y-2 md:col-span-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Nome Completo
              input(class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all dark:text-white" type="text" name="nome" value=user.nome required)
            
            div(class="space-y-2 md:col-span-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Instituição / Filiação
              input(class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all dark:text-white" type="text" name="filiacao" value=user.filiacao)

            div(class="space-y-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Departamento
              input(class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all dark:text-white" type="text" name="departamento" value=user.departamento)

            div(class="space-y-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Curso
              input(class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all dark:text-white" type="text" name="curso" value=user.curso)

          div(class="pt-4")
            button(class="w-full py-4 bg-primary text-white rounded-2xl font-bold hover:bg-primary-dark transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2" type="submit")
              i(data-lucide="save" class="w-5 h-5")
              | Guardar Alterações
