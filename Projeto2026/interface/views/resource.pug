extends layout

block content
  .w3-row-padding
    // Coluna da Esquerda: Detalhes do Recurso
    .w3-col.l8.m12
      .w3-card-4
        header.w3-container.w3-teal
          h2= resource.titulo
          if resource.subtitulo
            h4= resource.subtitulo
        
        .w3-container.w3-padding-16
          p
            b Tipo: 
            span.w3-tag.w3-teal.w3-round= resource.tipo
          p
            b Autor: 
            span= resource.produtor
          p
            b Data de Criação: 
            span= resource.dataCriacao ? new Date(resource.dataCriacao).toLocaleDateString() : 'N/A'
          p
            b Hashtags: 
            each tag in resource.hashtags
              a.w3-tag.w3-blue-grey.w3-tiny.w3-margin-right(href=`/resources?hashtag=${tag}`)= tag
          
          hr
          h3 Conteúdo do Pacote
          ul.w3-ul.w3-border
            each file in resource.files
              li.w3-padding-16
                i.fa.fa-file.w3-margin-right
                span= file.nome
                span.w3-right.w3-text-grey #{Math.round(file.size / 1024)} KB
          
          .w3-margin-top
            a.w3-btn.w3-blue-grey(href=`/resources/download/${resource._id}`) 
              i.fa.fa-download  Download (DIP)

    // Coluna da Direita: Comentários e Ranking
    .w3-col.l4.m12
      .w3-card-4
        header.w3-container.w3-blue-grey
          h2 Interações
        
        .w3-container.w3-padding-16
          h4 Classificação
          form(action=`/resources/rating/${resource._id}` method="POST")
            select.w3-select.w3-border(name="estrelas" onchange="this.form.submit()")
              option(value="" disabled selected) Atribuir estrelas
              option(value="5") 5 Estrelas
              option(value="4") 4 Estrelas
              option(value="3") 3 Estrelas
              option(value="2") 2 Estrelas
              option(value="1") 1 Estrela
          
          hr
          h4 Posts e Comentários
          if posts.length > 0
            each p in posts
              .w3-container.w3-border-bottom.w3-padding
                p.w3-small
                  b= p.userId 
                  span.w3-text-grey  em #{new Date(p.data).toLocaleString()}
                p= p.conteudo
                if p.ratings && p.ratings.length > 0
                   p.w3-small.w3-text-orange
                     each r in p.ratings
                       i.fa.fa-star  #{r.estrelas} estrelas por #{r.userId}
          else
            p Não existem posts sobre este recurso.
          
          form.w3-container.w3-light-grey.w3-padding-16.w3-margin-top(action=`/resources/post/${resource._id}` method="POST")
            label.w3-text-teal
              b Novo Post
            textarea.w3-input.w3-border(name="conteudo" rows="3" placeholder="O que achas deste recurso?" required)
            button.w3-btn.w3-teal.w3-margin-top.w3-right(type="submit") Comentar
