doctype html
html
  head
    title= title
    link(rel='stylesheet', href='https://www.w3schools.com/w3css/4/w3.css')
    link(rel='stylesheet', href='/stylesheets/style.css')
    link(rel='stylesheet', href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css')
  body
    // Navbar
    .w3-bar.w3-teal
      a.w3-bar-item.w3-button(href='/') 
        b EduPortal
      a.w3-bar-item.w3-button(href='/resources') Recursos
      
      // Obter user dos cookies (passado pelo router)
      if user
        if user.nivel == 'admin'
          a.w3-bar-item.w3-button(href='/admin') Admin
        if user.nivel == 'produtor' || user.nivel == 'admin'
          a.w3-bar-item.w3-button(href='/ingest') Ingestão (SIP)
        
        .w3-right
          span.w3-bar-item.w3-text-white Olá, #{user.nome} (#{user.nivel})
          a.w3-bar-item.w3-button(href='/logout') Logout
      else
        .w3-right
          a.w3-bar-item.w3-button(href='/login') Login
          a.w3-bar-item.w3-button(href='/register') Registar
    
    // Content
    .w3-container.w3-margin-top
      block content

    // Footer
    footer.w3-container.w3-teal.w3-center.w3-margin-top
      p EduPortal &copy; 2026 - Engenharia Web
