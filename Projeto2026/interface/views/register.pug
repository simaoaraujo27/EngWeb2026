extends layout

block content
  div(class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-gradient-to-br from-blue-50 to-gray-50 dark:from-slate-950 dark:to-slate-900 py-12 px-4 transition-colors")
    div(class="w-full max-w-xl")
      div(class="text-center mb-8")
        div(class="inline-flex items-center justify-center w-16 h-16 bg-primary rounded-2xl mb-4 shadow-lg shadow-primary/20")
          i(data-lucide="user-plus" class="text-white w-10 h-10")
        h1(class="text-3xl font-extrabold text-edu-dark dark:text-white") Criar Nova Conta
        p(class="text-edu-muted dark:text-slate-400 mt-2") Junte-se à nossa comunidade educativa

      div(class="bg-white dark:bg-slate-900 rounded-3xl border border-gray-100 dark:border-slate-800 shadow-xl overflow-hidden")
        div(class="p-8")
          if error
            div(class="mb-6 p-4 bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800 text-red-600 dark:text-red-400 rounded-xl text-sm flex items-center gap-2")
              i(data-lucide="alert-circle" class="w-4 h-4")
              = error

          form(class="grid grid-cols-1 md:grid-cols-2 gap-6" action="/register" method="POST")
            div(class="space-y-2 md:col-span-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Nome Completo
              div(class="relative")
                i(data-lucide="user" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400")
                input(class="w-full pl-11 pr-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary dark:text-white transition-all" type="text" name="nome" placeholder="João Silva" required)

            div(class="space-y-2 md:col-span-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Email / ID
              div(class="relative")
                i(data-lucide="mail" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400")
                input(class="w-full pl-11 pr-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary dark:text-white transition-all" type="email" name="_id" placeholder="aluno@instituicao.pt" required)

            div(class="space-y-2 md:col-span-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Instituição / Filiação
              div(class="relative")
                i(data-lucide="building" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400")
                input(class="w-full pl-11 pr-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary dark:text-white transition-all" type="text" name="filiacao" placeholder="Universidade do Minho")

            div(class="space-y-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Departamento
              div(class="relative")
                i(data-lucide="building-2" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400")
                input(class="w-full pl-11 pr-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary dark:text-white transition-all" type="text" name="departamento" placeholder="Departamento de Informática")

            div(class="space-y-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Curso
              div(class="relative")
                i(data-lucide="graduation-cap" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400")
                input(class="w-full pl-11 pr-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary dark:text-white transition-all" type="text" name="curso" placeholder="Licenciatura em Engenharia Informática")

            div(class="space-y-2 md:col-span-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Nível de Acesso
              div(class="relative")
                select(class="w-full pl-4 pr-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary dark:text-white transition-all appearance-none" name="nivel" required)
                  option(value="consumidor") 👤 Consumidor (Explorar e Descarregar)
                  option(value="produtor") 🎓 Produtor (Submeter Recursos)
                i(data-lucide="chevron-down" class="absolute right-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none")

            div(class="space-y-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Password
              div(class="relative")
                i(data-lucide="key" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400")
                input(class="w-full pl-11 pr-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary dark:text-white transition-all" type="password" name="password" placeholder="••••••••" required)

            div(class="space-y-2")
              label(class="text-sm font-bold text-gray-700 dark:text-slate-300") Confirmar Password
              div(class="relative")
                i(data-lucide="check-circle" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400")
                input(class="w-full pl-11 pr-4 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary dark:text-white transition-all" type="password" name="confirm_password" placeholder="••••••••" required)

            div(class="md:col-span-2 pt-4")
              button(class="w-full py-3 bg-primary text-white rounded-xl font-bold hover:bg-primary-dark transition-all shadow-lg shadow-primary/20" type="submit")
                | Criar Conta Agora

          div(class="mt-8 pt-8 border-t border-gray-50 dark:border-slate-800 text-center")
            p(class="text-sm text-gray-500 dark:text-slate-400")
              | Já tem conta? 
              a(href="/login" class="text-primary dark:text-blue-400 font-bold hover:underline") Faça login aqui
