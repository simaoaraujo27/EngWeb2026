extends layout

block content
  .w3-card-4.w3-margin.w3-display-middle(style="width:50%; min-width:350px;")
    .w3-container.w3-teal
      h2 Registo de Utilizador
    
    if error
      .w3-container.w3-red.w3-margin.w3-padding
        p= error

    form.w3-container.w3-padding-16(action="/register" method="POST")
      label.w3-text-teal
        b Nome Completo
      input.w3-input.w3-border.w3-light-grey(type="text" name="nome" required)

      label.w3-text-teal
        b Email (será o seu ID)
      input.w3-input.w3-border.w3-light-grey(type="email" name="_id" required)
      
      label.w3-text-teal
        b Filiação (ex: Curso, Departamento)
      input.w3-input.w3-border.w3-light-grey(type="text" name="filiacao")

      label.w3-text-teal.w3-margin-top
        b Nível de Acesso
      select.w3-select.w3-border(name="nivel" required)
        option(value="consumidor" selected) Consumidor
        option(value="produtor") Produtor
        option(value="admin") Administrador
      
      label.w3-text-teal.w3-margin-top
        b Password
      input.w3-input.w3-border(type="password" name="password" required)
      
      label.w3-text-teal.w3-margin-top
        b Confirmar Password
      input.w3-input.w3-border(type="password" name="confirm_password" required)
      
      button.w3-btn.w3-teal.w3-margin-top.w3-block(type="submit") Criar Conta
    
    .w3-container.w3-border-top.w3-padding-16.w3-light-grey.w3-center
      p Já tens conta? 
        a(href="/login") Faz login aqui
