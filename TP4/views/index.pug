extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 EMD List
      a.w3-btn.w3-round.w3-blue.w3-margin-bottom(href="/emd/registo") + New EMD
      a.w3-btn.w3-round.w3-light-blue.w3-margin-bottom.w3-margin-left(href="/emd/stats") Stats
  
  .w3-container.w3-margin-top
    p
      strong Date: 
      span= data
    
    .w3-bar.w3-border
      a.w3-bar-item.w3-button(href="/emd?_sort=nome.primeiro&_order=asc") Sort by Name (Asc)
      a.w3-bar-item.w3-button(href="/emd?_sort=dataEMD&_order=desc") Sort by Date (Desc)
  
  table.w3-table-all
    thead
      tr.w3-green
        th Name
        th Date
        th Modality
        th Result
        th Actions
    tbody
      each emd in emds
        tr
          td(style="cursor: pointer;" onclick=`location.href='/emd/${emd._id || emd.id}'`)= emd.nome.primeiro + ' ' + emd.nome.último
          td(style="cursor: pointer;" onclick=`location.href='/emd/${emd._id || emd.id}'`)= emd.dataEMD
          td(style="cursor: pointer;" onclick=`location.href='/emd/${emd._id || emd.id}'`)= emd.modalidade
          td(style="cursor: pointer;" onclick=`location.href='/emd/${emd._id || emd.id}'`)= emd.resultado ? '✓ Pass' : '✗ Fail'
          td
            a.w3-button.w3-blue(href=`/emd/editar/${emd.id || emd._id}`) Edit
            a.w3-button.w3-red(href=`/emd/apagar/${emd.id || emd._id}`) Delete
