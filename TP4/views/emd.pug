extends layout

block content
  if emd
    .w3-card-4
      header.w3-container.w3-teal
        h2= emd.nome.primeiro + ' ' + emd.nome.último
      .w3-container
        p
          strong Data EMD: 
          span= emd.dataEMD
        p
          strong Modalidade: 
          span= emd.modalidade
        p
          strong Idade: 
          span= emd.idade
        p
          strong Género: 
          span= emd.género
        p
          strong Clube: 
          span= emd.clube
        p
          strong Resultado: 
          span= emd.resultado ? '✓ Pass' : '✗ Fail'
        p
          strong Federado: 
          span= emd.federado ? 'Yes' : 'No'
      .w3-container.w3-margin-top.w3-margin-bottom
        a.w3-button.w3-light-blue(href="/") Go back
        a.w3-button.w3-blue.w3-margin-left(href=`/emd/editar/${emd.id || emd._id}`) Edit
        a.w3-button.w3-red.w3-margin-left(href=`/emd/apagar/${emd.id || emd._id}`) Delete
  else
    p.w3-center No data available
